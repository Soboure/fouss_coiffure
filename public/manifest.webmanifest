/* Le navigateur lit ce fichier pour installer le site.
   Il doit rester dans public/ : Vite le copie à la racine.
   start_url /app : l'icône du téléphone ouvre l'écran appli, pas la page vitrine. */
{
  "name": "Fouss Coiffure",
  "short_name": "Fouss",
  "description": "Réserver une prestation au salon Fouss Coiffure, Cotonou.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#8C1913",
  "theme_color": "#8C1913",
  "lang": "fr",
  "icons": [
    {
      "src": "/logo-fouss.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo-fouss.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
